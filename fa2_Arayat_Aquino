class Patient:
    def __init__(self, __name, __bill_amount):
        self.__name = __name
        self.__bill_amount = __bill_amount

    def get_name(self):
        return "Patient name: " + self.__name

    def get_bill_amount(self):
        return "Original bill: " + str(float(self.__bill_amount))

    def set_name(self, newname):
        self.__name = newname

    def set_bill_amount(self, newbill):
        if newbill < 0:
            print("Bill amount must be positive")
        else:
            self.__bill_amount = newbill

    def calculate_bill(self):
        return "Final Bill: ₱" + str(float(self.__bill_amount))


